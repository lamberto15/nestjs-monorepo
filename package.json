{
  "name": "nestjs-monorepo",
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "services:up": "docker compose -f compose.dev.yaml up -d --wait",
    "services:down": "docker compose -f compose.dev.yaml down",
    "env:example": "pnpm --filter api build && node tools/env-example.mjs",
    "env:check": "pnpm --filter api build && node tools/env-example.mjs --check",
    "test:tools": "node --test tools/"
  },
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "turbo": "2.11.11"
  }
}
