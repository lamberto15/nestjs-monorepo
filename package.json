{
  "name": "nestjs-monorepo",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@12.22.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "services:up": "docker compose -f compose.dev.yaml up -d --wait",
    "services:down": "docker compose -f compose.dev.yaml down",
    "traces:up": "sh tools/dev/traces-up.sh",
    "storage:up": "docker compose -f compose.dev.yaml --profile storage up -d --wait garage && sh tools/dev/garage-setup.sh",
    "env:example": "pnpm --filter api build && node tools/env-example.mjs",
    "env:check": "pnpm --filter api build && node tools/env-example.mjs --check",
    "test:tools": "node --test tools/",
    "feature:add": "node tools/feature-add.mjs",
    "module:list": "node tools/module.mjs list",
    "module:remove": "node tools/module.mjs remove",
    "template:check": "node tools/template.mjs check",
    "ops": "pnpm --filter api ops",
    "openapi:dump": "pnpm --filter api openapi:dump",
    "client:generate": "pnpm openapi:dump && pnpm --filter @nestjs-monorepo/api-client generate",
    "client:check": "pnpm client:generate && git diff --exit-code -- packages/api-client",
    "typecheck": "turbo run typecheck",
    "setup": "node tools/setup/setup.mjs",
    "knip": "knip",
    "raw-sql": "node tools/ci/raw-sql.mjs",
    "db:generate": "pnpm --filter api db:generate",
    "db:seed:demo": "pnpm --filter api db:seed:demo",
    "db:mark-dev": "docker compose -f compose.dev.yaml exec -T postgres psql -v ON_ERROR_STOP=1 -U app -d app < tools/dev/10-dev-database.sql",
    "test:e2e:web": "turbo run test:browser --env-mode=loose --"
  },
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "knip": "6.47.0",
    "lefthook": "2.2.2",
    "turbo": "2.11.13"
  }
}
