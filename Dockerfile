# syntax=docker/dockerfile:1
# The production image (the API, and the web app it serves), built from the
# repository root:
#   docker build -t app .
# One image, three commands (the compose or orchestrator command picks one):
#   node dist/main      the HTTP API (the default)
#   node dist/worker    the queue and schedule worker
#   node dist/migrate   the migrations, once per deploy (MIGRATE_ON_START off)
# Every base image is pinned by digest; Dependabot raises both tag and digest.

# pnpm's own binary, at the version of package.json's packageManager.
FROM ghcr.io/pnpm/pnpm:12.22.0@sha256:81346f048d668195928d441b80efc0df300474ed8bf81789e4554ec0079079d0 AS pnpm

# Debian 13 (glibc), so the native modules installed here run in the final stage.
FROM node:26.13.1-trixie-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc AS build
COPY --from=pnpm /opt/pnpm/pnpm /usr/local/bin/pnpm
WORKDIR /app
# One store for every pnpm command below (a later command that looked for
# another would refuse the node_modules linked from this one).
ENV pnpm_config_store_dir=/pnpm-store
# Every package of the lockfile into the store, from the lockfile alone: this
# layer stays cached until a dependency changes, whatever the code does. The
# store is part of the layer, not a cache mount, so the offline install below
# always finds it.
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN CI=true pnpm fetch
COPY . .
RUN CI=true pnpm install --frozen-lockfile --offline --filter 'api...' --filter '@nestjs-monorepo/web...'
# The web app's build names the commit it was built from (version.json).
ARG GIT_SHA=""
RUN GIT_SHA=${GIT_SHA} pnpm --filter 'api...' --filter '@nestjs-monorepo/web...' build
# The API as a package of its own: its package.json, the files it lists (dist,
# drizzle) and a node_modules of its production dependencies only.
RUN pnpm --filter api deploy --prod /deploy/api

FROM node:26.13.1-trixie-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc
# The app runs on node alone: drop the npm CLI the base image bundles. Nothing
# uses it, and its own dependencies are what an image scan flags first.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
WORKDIR /app
ENV NODE_ENV=production TZ=UTC
COPY --from=build --chown=root:root /deploy/api/package.json ./
COPY --from=build --chown=root:root /deploy/api/node_modules ./node_modules
# The build output, with the i18n catalogs and mail templates nest-cli.json copies into it.
COPY --from=build --chown=root:root /deploy/api/dist ./dist
# Generated by drizzle-kit; applied by `node dist/migrate` (or at start).
COPY --from=build --chown=root:root /deploy/api/drizzle ./drizzle
# The web app, served by the API from its own origin (core/web).
COPY --from=build --chown=root:root /app/apps/web/dist ./web
ENV WEB_ROOT=/app/web
# The only writable place: local files (STORAGE_DRIVER local, the mail drive
# directory) default to /app/.data. Mount a volume on it, or use S3 and SMTP.
RUN mkdir -p /app/.data && chown node:node /app/.data
# The rest is read-only for the app: it runs as the unprivileged `node` user.
USER node
# The commit the image was built from (CI passes it as the release the
# observability backends report). Empty in a local build.
ARG GIT_SHA=""
ENV GIT_SHA=${GIT_SHA}
EXPOSE 3000
# Liveness only: the process answers. Readiness (database, Redis) is /health.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/health/live').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["node", "dist/main"]
