# Generated from the src/**/*.config.ts schemas by tools/env-example.mjs.
# Do not edit: change a schema and run `pnpm env:example`.
# Copy to .env (cp env.example .env). A line starting with # is optional,
# shown with its default.

# --- core/database ---
# PostgreSQL 18 or later, as the app's role: no superuser, no BYPASSRLS, owning nothing, so row-level security binds it. The migrations make it from this URL (README.md, "Roles").
# Secret: DATABASE_URL_FILE can name a file holding it instead.
# Required.
DATABASE_URL=postgres://app_runtime:app_runtime@127.0.0.1:5432/app
# The same database as the owner of its tables: runs the migrations (MIGRATE_ON_START, node dist/migrate) and makes the other roles. Give it to the migration only. Unset outside production: postgres://app:app@127.0.0.1:5432/app.
# Secret: DATABASE_OWNER_URL_FILE can name a file holding it instead.
# DATABASE_OWNER_URL=
# The maintenance role (BYPASSRLS), for work across every tenant (Tenancy.acrossTenants()); the migrations make it. Give it to workers only; unset, that work is refused. Unset outside production: postgres://app_maintenance:app_maintenance@127.0.0.1:5432/app.
# Secret: DATABASE_MAINTENANCE_URL_FILE can name a file holding it instead.
# DATABASE_MAINTENANCE_URL=
# Connections this process may hold: replicas × this must stay under max_connections.
# DATABASE_POOL_MAX=10
# How long a query waits for a free connection before it fails: never hang.
# DATABASE_POOL_TIMEOUT_MS=5000
# PostgreSQL cancels a statement running longer (0: never). Migrations have none.
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# PostgreSQL ends a session left idle inside a transaction this long (0: never).
# DATABASE_IDLE_TX_TIMEOUT_MS=60000
# Which process holds a connection, in pg_stat_activity.
# DATABASE_APPLICATION_NAME=api
# Apply pending migrations at start: on by default outside production. Production runs `node dist/migrate` once per deploy instead.
# One of: on, off.
# MIGRATE_ON_START=
# `production` in a deployment: no migrations at start, JSON logs, strict browser headers, missing texts fall back.
# NODE_ENV=

# --- core/encryption ---
# Data keys: `openssl rand -base64 32` each. The first encrypts, all decrypt.
# DATA_ENCRYPTION_KEYS=
# Blind-index keys, the same way; never a key also in DATA_ENCRYPTION_KEYS.
# BLIND_INDEX_KEYS=

# --- core/http ---
# The public origin of this API, for the links it hands out (signed file URLs, mails).
# APP_URL=http://localhost:3000
# The web app's base URL: the links in mails (reset, verification, invitations, magic links) open its pages, and sign-ins (OIDC, SSO) land on it. Unset: APP_URL (the API serves the web app).
# WEB_URL=
# Browser apps on other origins (`https://admin.example.com`, comma-separated): CORS, and the origins allowed to send cookie-authenticated writes (CSRF).
# CORS_ORIGINS=
# The keys sorted lists' cursors are sealed with, newest first, comma-separated (each `openssl rand -base64 32`). Every instance needs the same; unset, one is made once and kept in the database (core/secrets), so every instance reads the same.
# Secret: CURSOR_KEYS_FILE can name a file holding it instead.
# CURSOR_KEYS=
# The OpenAPI document and Swagger UI at /api.
# One of: on, off.
# OPENAPI=on

# --- core/i18n ---
# The languages this deployment enables, comma separated; the first is the default. Shipped: en.
# LOCALES=

# --- core/idempotency ---
# `required`: the routes marked @IdempotentRoute() refuse a request without an Idempotency-Key (400). `optional`: a key is honoured when sent, never demanded.
# One of: required, optional.
# IDEMPOTENCY=required
# Seal stored idempotent responses: base64 keys, newest first. Unset: created once, kept in the database.
# Secret: IDEMPOTENCY_KEYS_FILE can name a file holding it instead.
# IDEMPOTENCY_KEYS=

# --- core/locks ---
# Scheduled jobs (@Cron, @Interval, @Timeout): off for tests and for an instance that must not run them.
# One of: on, off.
# SCHEDULER=on

# --- core/logging ---
# The lowest level written; Nest's names, from most to least talkative.
# One of: verbose, debug, log, warn, error, fatal.
# LOG_LEVEL=log
# One JSON object per line, or readable text. Defaults to JSON in production.
# One of: json, text.
# LOG_FORMAT=

# --- core/mail ---
# How mail leaves: `file` (.eml files in MAIL_DIRECTORY, development), `log` (printed), `smtp` (SMTP_URL), `resend`, `postmark`, `sendgrid` (MAIL_API_KEY), `ses` (AWS_* credentials), or `memory` (tests).
# One of: file, log, smtp, resend, postmark, sendgrid, ses, memory.
# MAIL_TRANSPORT=file
# Which mail leaves: `all`, `essential` (only mail marked `@EssentialMail()`: a staging server that must still send sign-in links) or `off` (none: a copy of production's data).
# One of: all, essential, off.
# MAIL_DELIVERY=all
# Extra directories searched for `templates/` folders, comma-separated, besides the application's own source (tests, templates shipped apart).
# MAIL_TEMPLATE_ROOTS=
# The sender of every mail.
# MAIL_FROM=My API <no-reply@example.com>
# Where the `file` transport writes the .eml files.
# MAIL_DIRECTORY=.data/mail
# smtp://user:password@smtp.example.com:587 (STARTTLS) or smtps://…:465.
# Secret: SMTP_URL_FILE can name a file holding it instead.
# SMTP_URL=
# The API key or token of the HTTP provider MAIL_TRANSPORT names.
# Secret: MAIL_API_KEY_FILE can name a file holding it instead.
# MAIL_API_KEY=
# SES's endpoint: unset for AWS; http://localhost:4566 for a local emulator.
# SES_ENDPOINT=
# AWS region for SES.
# AWS_REGION=
# AWS access key for SES; unset, the AWS SDK's own credential lookup applies.
# AWS_ACCESS_KEY_ID=
# Secret: AWS_SECRET_ACCESS_KEY_FILE can name a file holding it instead.
# AWS_SECRET_ACCESS_KEY=
# Secret: AWS_SESSION_TOKEN_FILE can name a file holding it instead.
# AWS_SESSION_TOKEN=

# --- core/metrics ---
# Prometheus' bearer token for GET /metrics (at least 16 characters); unset, /metrics answers 404. Scrape from inside the private network.
# Secret: METRICS_TOKEN_FILE can name a file holding it instead.
# METRICS_TOKEN=

# --- core/observability ---
# The service's name in traces and error reports.
# SERVICE_NAME=api
# The commit being run (the image's build argument): the release in traces and error reports.
# GIT_SHA=
# NestJS Observe (traces, metrics, errors, logs): on when both keys are set (your project's API keys page, or `npx @nestjs/observe link`).
# Secret: OBSERVE_APP_KEY_FILE can name a file holding it instead.
# OBSERVE_APP_KEY=
# The secret that goes with OBSERVE_APP_KEY.
# Secret: OBSERVE_APP_SECRET_FILE can name a file holding it instead.
# OBSERVE_APP_SECRET=
# OpenTelemetry export (traces and metrics over OTLP/HTTP), for a self-hosted backend: the Nestrix server (http://nestrix-server:4318), or any collector. On when set. The SDK also reads the standard OTEL_* variables itself (OTEL_TRACES_SAMPLER, OTEL_RESOURCE_ATTRIBUTES…). With NestJS Observe on too, Observe exports its traces there and the standalone SDK stays off.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# The collector's credential, as `name=value,name=value`.
# Secret: OTEL_EXPORTER_OTLP_HEADERS_FILE can name a file holding it instead.
# OTEL_EXPORTER_OTLP_HEADERS=

# --- core/outbox ---
# The outbox relay, which delivers events to their subscribers: off in tests, which drive it with runOnce(), and in a worker kept for heavy queues.
# One of: on, off.
# OUTBOX_RELAY=on
# Outbox events the relay claims per poll.
# OUTBOX_RELAY_BATCH_SIZE=100
# Outbox events the relay delivers at once.
# OUTBOX_RELAY_CONCURRENCY=10
# Outbox dead letters (events given up on) older than this many days are deleted every night; requeue them before.
# OUTBOX_DEAD_LETTER_RETENTION_DAYS=14
# Consumers' inbox records (which events each processed) older than this many days are deleted every night.
# OUTBOX_INBOX_RETENTION_DAYS=30

# --- core/queues ---
# What this process runs: `api` serves HTTP only, `worker` runs the queue workers and the scheduled jobs (`node dist/worker` sets it), `all` both (development, small deployments).
# One of: all, api, worker.
# APP_ROLE=all
# Split the workers: the only queues this worker takes (unset: every one), and the ones it leaves to another worker. So the heavy queues can run in a worker of their own, whose memory spike leaves mail running.
# WORKER_QUEUES=
# WORKER_QUEUES_EXCLUDE=

# --- core/redis ---
# Redis 7 or later. `rediss://` turns TLS on; the path is the database number.
# Secret: REDIS_URL_FILE can name a file holding it instead.
# REDIS_URL=redis://127.0.0.1:6379
# Replaces the URL's password: for one kept in a file (REDIS_PASSWORD_FILE).
# Secret: REDIS_PASSWORD_FILE can name a file holding it instead.
# REDIS_PASSWORD=
# Redis behind Sentinel, for failover: `host:port` of each sentinel (comma-separated), and the monitored master's name. REDIS_URL then only gives the password, the database number and TLS.
# REDIS_SENTINELS=
# REDIS_SENTINEL_NAME=mymaster
# Prefix of every key and queue this app writes, so apps can share a Redis.
# REDIS_PREFIX=app

# --- core/tenancy ---
# `multi`: many tenants. `single`: one, made at the first start, and no other can be made. The wall and every `tenant_id` stay in both, so a deployment switches by this variable alone, with no data migration.
# One of: multi, single.
# TENANCY=multi

# --- core/throttling ---
# `redis` counts rate limits in Redis, shared by every instance; `memory` per instance (one instance, or tests).
# One of: redis, memory.
# RATE_LIMIT_STORE=redis
# Multiplies every rate limit (the global 600 a minute and each route's `@Throttle()`). For the load test's stack only, whose requests all come from one address: limits are raised there, never turned off. Keep it 1 everywhere else: with NODE_ENV=production, above 1 stops the app unless APP_ENV=loadtest.
# RATE_LIMIT_MULTIPLIER=1
# `loadtest` names the load test's throwaway stack, the only production deployment allowed RATE_LIMIT_MULTIPLIER above 1.
# APP_ENV=

# --- core/web ---
# The folder of the built web app (`apps/web/dist`: its `index.html`), served on every path the API doesn't own. Unset, the API serves no web app. The image sets it.
# WEB_ROOT=
# Other origins the web app may load files from and send them to (`https://files.example.com`, comma-separated): the bucket's, when browsers upload and download there directly (STORAGE_DRIVER=s3).
# WEB_FILES_ORIGINS=
# Where to report a vulnerability, published at `/.well-known/security.txt` (RFC 9116): an address (`security@example.com`) or a `https://` page. Unset, there is none (404).
# SECURITY_CONTACT=
# When security.txt says it goes stale (ISO 8601, `2027-06-30T00:00:00Z`): a date you will renew it by. Unset: always 180 days ahead.
# SECURITY_TXT_EXPIRES=

# --- core/workflows ---
# Workflow steps run in this process: off in a worker kept for the heavy queues (WORKER_QUEUES) and in tests.
# One of: on, off.
# WORKFLOWS_WORKER=on
# Workflow instances this process executes at once.
# WORKFLOW_CONCURRENCY=10

# --- iam/access ---
# The first administrator's address, made on a deployment's first start (AccessSeeder). The placeholder default asks for a real one at the first sign-in (ADMIN_ONBOARDING).
# ADMIN_EMAIL=admin@example.com
# The first administrator's password. Unset: one is generated and logged once.
# Secret: ADMIN_PASSWORD_FILE can name a file holding it instead.
# ADMIN_PASSWORD=
# On: a first administrator on the placeholder address, or with the generated password, must replace it at their first sign-in.
# One of: on, off.
# ADMIN_ONBOARDING=on
# The name of the first tenant, the operators' (its slug is OPERATOR_TENANT, or made from the name).
# ADMIN_TENANT_NAME=Operators

# --- iam/account ---
# Passwordless sign-in by email link (POST /auth/magic-link). Off: its routes answer 404 `feature_off`.
# One of: on, off.
# AUTH_MAGIC_LINK=on
# Two-factor sign-in with an authenticator app. Off: setting it up (POST /auth/mfa/enroll, /confirm) answers 404 `feature_off`; accounts that have it keep being asked for a code, and may turn it off.
# One of: on, off.
# AUTH_MFA=on
# The name authenticator apps show; default SERVICE_NAME.
# MFA_ISSUER=
# New passwords (reset, invitation, change) are checked against known data breaches (Have I Been Pwned's Pwned Passwords, by k-anonymity: only 5 characters of the password's SHA-1 leave the process).
# One of: on, off.
# PASSWORD_BREACH_CHECK=on
# The range API's base URL: a self-hosted mirror for air-gapped deployments.
# PASSWORD_BREACH_API_URL=https://api.pwnedpasswords.com
# How long a check may take, in milliseconds (one attempt: the user waits on it).
# PASSWORD_BREACH_TIMEOUT_MS=2000
# When the API can't be reached: `allow` the password unchecked, with a warning in the logs (fail-open), or `reject` it with a 503 `password_check_unavailable` (fail-closed).
# One of: allow, reject.
# PASSWORD_BREACH_ON_ERROR=allow
# Refused when seen in at least this many breaches.
# PASSWORD_BREACH_MIN_COUNT=1
# The password of a sign-in is checked against the breaches too (without delaying it): once per password, then again after this many days (the corpus grows), until the password changes.
# PASSWORD_BREACH_RECHECK_DAYS=30
# A new password may not repeat the account's last N (the current one counts); 0: off. Only hashes are kept, and only while this is on.
# PASSWORD_HISTORY=0
# Password hashes (scrypt, 128 MiB each outside the heap) running at once in this process: the container's memory limit must hold the heap plus this many.
# PASSWORD_HASH_CONCURRENCY=2
# Hashes waiting for a slot; beyond that, 503 `server_busy` at once.
# PASSWORD_HASH_MAX_QUEUE=20
# How long a hash waits for a slot (milliseconds), then 503 `server_busy`.
# PASSWORD_HASH_QUEUE_TIMEOUT_MS=5000
# Where a native app's sign-in through the system browser (a provider, a magic link opened by the app) may end: the app's own scheme or universal / app link (`com.example.app:/auth`, `https://app.example.com/auth/native`), comma-separated, matched exactly. Empty: none.
# NATIVE_REDIRECT_URIS=
# Passkeys: registering them, signing in with them (POST /auth/passkeys/…).
# One of: on, off.
# PASSKEYS=on
# The relying party id: a registrable domain the web app is served on (`example.com` covers `app.example.com` too), never a port or a scheme. Unset: WEB_URL's host (else APP_URL's). It never changes once passkeys exist: every credential is bound to it.
# PASSKEY_RP_ID=
# The name authenticators show for this service; default SERVICE_NAME.
# PASSKEY_RP_NAME=
# Origins ceremonies may run on, besides WEB_URL's (comma-separated `https://…` URLs, or `android:apk-key-hash:…`). Each https origin's host must be the RP ID or under it.
# PASSKEY_ORIGINS=
# How long a ceremony's challenge lives, in seconds (one-time, in Redis).
# PASSKEY_CHALLENGE_TTL_SECONDS=120
# Android apps allowed to use this RP ID's passkeys (served at /.well-known/assetlinks.json): `package.name:SHA256_FINGERPRINT` of the signing certificate (colon-separated hex), comma-separated.
# PASSKEY_ANDROID_APPS=
# iOS and macOS apps allowed to use this RP ID's passkeys (served at /.well-known/apple-app-site-association): `TEAMID.bundle.identifier`, comma-separated.
# PASSKEY_APPLE_APPS=
# Google's OAuth client id.
# GOOGLE_CLIENT_ID=
# Google's OAuth client secret.
# Secret: GOOGLE_CLIENT_SECRET_FILE can name a file holding it instead.
# GOOGLE_CLIENT_SECRET=
# Microsoft Entra ID: the tenant's id (a GUID), single tenant.
# MICROSOFT_TENANT_ID=
# Microsoft Entra ID: the application's client id.
# MICROSOFT_CLIENT_ID=
# Microsoft Entra ID: the application's client secret.
# Secret: MICROSOFT_CLIENT_SECRET_FILE can name a file holding it instead.
# MICROSOFT_CLIENT_SECRET=
# GitHub's OAuth app client id.
# GITHUB_CLIENT_ID=
# GitHub's OAuth app client secret.
# Secret: GITHUB_CLIENT_SECRET_FILE can name a file holding it instead.
# GITHUB_CLIENT_SECRET=

# --- iam/audit ---
# Audit entries older than this many days are deleted every night (03:15 UTC).
# AUDIT_RETENTION_DAYS=400

# --- iam/auth ---
# A browser session ends after this many minutes without a request. The deployment's ceiling: a tenant's own limit may only shorten it.
# SESSION_IDLE_MINUTES=120
# A browser session ends this many hours after its sign-in, however active. The deployment's ceiling: a tenant's own limit may only shorten it, and then also its token clients' refresh-token families.
# SESSION_MAX_HOURS=12
# Off only for plain HTTP on a host other than localhost; the cookie is then named `sid`, not `__Host-sid`.
# One of: on, off.
# SESSION_COOKIE_SECURE=on
# Signs the access tokens of mobile apps and CLIs (HS256, 32+ bytes). Unset: one is made once and kept in the database (core/secrets).
# Secret: JWT_SECRET_FILE can name a file holding it instead.
# JWT_SECRET=
# API clients (keys `sk_…`). Off: a key no longer authenticates (401) and the routes that manage clients answer 404 `feature_off`; users are unaffected, and keys work again once it is on.
# One of: on, off.
# API_CLIENTS=on
# Support impersonation (an administrator acts as a user). Off: a session that impersonates ends at its next request, and the routes that start one answer 404 `feature_off`. A privileged tool: opt in.
# One of: on, off.
# IMPERSONATION=off
# How long a sign-in counts as recent for the sensitive routes (`@RecentAuthentication()`): older, they answer 403 `reauthentication_required`.
# REAUTHENTICATION_MAX_AGE_MINUTES=10
# The slug of the operators' tenant: its members may use the routes that reach past one tenant (`@OperatorOnly()`), given their permission. Unset: nobody may (with TENANCY=single the one tenant is the operators').
# OPERATOR_TENANT=

# --- iam/captcha ---
# When a challenge token (`X-Captcha-Token`) is required on the routes that ask for one (sign-in, sign-up, forgot password…): `always`, `after-failures` (once an address or an account had CAPTCHA_FAILURES failed attempts in CAPTCHA_FAILURES_WINDOW_MINUTES), or `off`.
# One of: off, always, after-failures.
# CAPTCHA_MODE=off
# Who verifies the tokens: Cloudflare `turnstile`, or the `stub` of the tests and load tests (refused in production, except APP_ENV=loadtest).
# One of: turnstile, stub.
# CAPTCHA_PROVIDER=turnstile
# Turnstile's site key (public: the widget's, shown by GET /auth/captcha). Required with the mode on.
# TURNSTILE_SITE_KEY=
# Turnstile's secret key, for the server-side verification. Required with the mode on.
# Secret: TURNSTILE_SECRET_KEY_FILE can name a file holding it instead.
# TURNSTILE_SECRET_KEY=
# The siteverify endpoint: Cloudflare's, or a stand-in in tests.
# CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# The host names the widget may run on, as the provider reports them (comma-separated, no port). Unset: the hosts of APP_URL and CORS_ORIGINS.
# CAPTCHA_HOSTNAMES=
# How long a verification may take (one attempt: the user waits on it).
# CAPTCHA_TIMEOUT_MS=2000
# When the provider can't be reached (timeout, error, circuit open): `allow` the request under a stricter limit (CAPTCHA_DEGRADED_LIMIT per address in the window: fail-open), or `reject` it with a 503 `captcha_unavailable` (fail-closed).
# One of: allow, reject.
# CAPTCHA_ON_ERROR=allow
# `after-failures`: failed attempts per address (and per email and address) before a token is required.
# CAPTCHA_FAILURES=3
# The window of CAPTCHA_FAILURES, and of CAPTCHA_DEGRADED_LIMIT.
# CAPTCHA_FAILURES_WINDOW_MINUTES=15
# Fail-open: requests let through unverified per address (and per email and address) in the window.
# CAPTCHA_DEGRADED_LIMIT=2
# App attestation: where a challenge token is asked for, a genuine build of an app in APP_ATTESTATION_APPLE_APPS (App Attest) or APP_ATTESTATION_ANDROID_APPS (Play Integrity) may send `X-App-Attestation` instead. Off: only the widget's token.
# One of: on, off.
# APP_ATTESTATION=off
# iOS apps App Attest vouches for: `TEAMID.bundle.identifier`, comma-separated.
# APP_ATTESTATION_APPLE_APPS=
# Android apps Play Integrity vouches for: `package.name:AA:BB:…` (the signing certificate's SHA-256 fingerprint (comma-separated; the fingerprint as `keytool` prints it, 32 colon-separated hex pairs).
# APP_ATTESTATION_ANDROID_APPS=
# App Attest's development environment too (debug builds): never in production.
# One of: on, off.
# APP_ATTEST_DEVELOPMENT=off
# Play Integrity's response decryption key (Play Console, base64): verdicts are decrypted here, no call to Google.
# Secret: PLAY_INTEGRITY_DECRYPTION_KEY_FILE can name a file holding it instead.
# PLAY_INTEGRITY_DECRYPTION_KEY=
# Play Integrity's response verification key (Play Console, base64 SPKI).
# PLAY_INTEGRITY_VERIFICATION_KEY=

# --- iam/impersonation ---
# How long an administrator may act as another user (IMPERSONATION=on): the impersonation session ends then, whatever its activity.
# IMPERSONATION_TTL_MINUTES=60

# --- iam/invitations ---
# How long an invitation's link works, in hours.
# INVITATION_TTL_HOURS=168

# --- iam/personal-data ---
# Days between a person asking for their account's deletion and the nightly job carrying it out; they may cancel until then.
# ACCOUNT_DELETION_GRACE_DAYS=14

# --- iam/sso ---
# Let SSO connections use http:// and loopback addresses (an IdP on localhost, in development and tests). Never in production: a tenant's administrator could make the API call its own host.
# One of: on, off.
# SSO_ALLOW_LOOPBACK=off

# --- iam/tenants ---
# Self sign-up (`POST /v1/auth/sign-up`): anyone may make an account, which signs in once its address is proved. Off: only invitations add people.
# One of: on, off.
# AUTH_SIGN_UP=off
# With TENANCY=multi and AUTH_SIGN_UP=on, a sign-up makes its own tenant and is its first administrator. Ignored (with a warning) otherwise.
# One of: on, off.
# TENANT_SIGN_UP=off
# With TENANCY=single, the seed roles (keys, comma-separated) a sign-up gets in the one tenant; never `administrator`. Empty: none.
# SIGN_UP_ROLES=
# Days between an operator's request to delete a tenant and its erase.
# TENANT_DELETION_GRACE_DAYS=30
# Tenants' own domains (`/v1/branding/domains`), proved by a DNS TXT record. Off: the routes answer 404 and no host names a tenant.
# One of: on, off.
# CUSTOM_DOMAINS=off

# --- modules/ai ---
# The Anthropic API key. Unset, the AI helper is off: nothing is ever sent anywhere (503 `ai_unavailable`).
# Secret: ANTHROPIC_API_KEY_FILE can name a file holding it instead.
# ANTHROPIC_API_KEY=
# The host of an Anthropic-compatible endpoint (`/v1` is added); unset: Anthropic's.
# AI_BASE_URL=
# The model of the `default` tier: a pinned id, never `latest`.
# AI_MODEL=claude-sonnet-5-5
# The model of the `cheap` tier (short, simple tasks): a pinned id.
# AI_MODEL_CHEAP=claude-haiku-5-5
# Milliseconds one attempt of a model call may take (at most two minutes: the worker's lock is three).
# AI_TIMEOUT_MS=60000
# The most tokens a model may answer with.
# AI_MAX_OUTPUT_TOKENS=1024
# Tries of a run the queue makes in all (a transient provider failure is retried).
# AI_ATTEMPTS=2
# Seconds an identical prompt is answered from Redis; 0: never.
# AI_CACHE_TTL_SECONDS=3600

# --- modules/attachments ---
# The largest attachment, in MB (413 `payload_too_large` past it).
# ATTACHMENT_MAX_MB=25
# The types an attachment may be, comma-separated, recognized from the file's bytes (415 otherwise). Empty: images, PDF, Office documents, text, CSV and zip.
# ATTACHMENT_ALLOWED_TYPES=
# Malware scanning of uploads. `off`: files are served as soon as they are stored. `clamav`: a queue job streams each upload to clamd (CLAMAV_HOST); it is `pending` (not downloadable) until clean, and an infected file is deleted. `memory`: a test double that flags the EICAR test string.
# One of: off, clamav, memory.
# MALWARE_SCANNER=off
# clamd's host; required with MALWARE_SCANNER=clamav.
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# How long clamd may take to answer one scan, in milliseconds.
# CLAMAV_TIMEOUT_MS=60000
# Attempts of a queued scan (exponential backoff from 5 s) before the retry job takes over.
# MALWARE_SCAN_ATTEMPTS=5
# `on`: uploaded JPEG, PNG, WebP and GIF images get a thumbnail and a preview, and an original carrying metadata is replaced by a copy without it (modules/images). `off`: images are stored as uploaded.
# One of: on, off.
# IMAGE_PROCESSING=on
# `on`: the global search also finds files by what they say (the text of plain text, CSV, PDF and DOCX uploads is extracted on a worker).
# One of: on, off.
# ATTACHMENT_TEXT_SEARCH=off
# The largest file whose text is extracted, in MB (a larger one is stored `failed`).
# ATTACHMENT_TEXT_MAX_MB=20
# How long one extraction may run, in milliseconds, before its thread is stopped.
# ATTACHMENT_TEXT_TIMEOUT_MS=30000

# --- modules/attachments/avatars ---
# The largest picture a user may set (PUT /v1/account/avatar), in MB: 413 past it.
# AVATAR_MAX_MB=2

# --- modules/bulk ---
# Most ids a bulk run answers in the request itself; more, and every filter selection, is a background job.
# BULK_SYNC_LIMIT=100

# --- modules/data-transfer ---
# The largest import file the deployment accepts, in bytes; the `dataTransfer.importMaxMiB` setting may only lower it.
# IMPORT_MAX_BYTES=52428800
# The most data rows one import may hold; the `dataTransfer.importMaxRows` setting may only lower it.
# IMPORT_MAX_ROWS=1000000
# The IANA time zone of a file's dates when neither the request nor the user names one.
# TRANSFER_TIMEZONE=UTC

# --- modules/deliverability ---
# The SNS topics whose notifications `POST /v1/webhooks/mail/ses` accepts (comma-separated ARNs): the ones SES publishes bounces and complaints to. Empty: every notification is refused (403), so the route is inert.
# SES_SNS_TOPIC_ARNS=
# Refuse SNS messages signed with SignatureVersion 1 (SHA1): set the topic's attribute to 2 first.
# One of: on, off.
# SES_SNS_REQUIRE_SIGNATURE_V2=off
# Postmark's webhooks (`POST /v1/webhooks/mail/postmark`): the shared secret, sent as the Basic Auth password of the webhook URL or in the `X-Postmark-Webhook-Secret` header (Postmark does not sign). Unset: refused (403).
# Secret: POSTMARK_WEBHOOK_SECRET_FILE can name a file holding it instead.
# POSTMARK_WEBHOOK_SECRET=
# Resend's signed webhooks (`POST /v1/webhooks/mail/resend`): the endpoint's signing secret (`whsec_…`), verified the Svix way. Unset: refused (403).
# Secret: RESEND_WEBHOOK_SECRET_FILE can name a file holding it instead.
# RESEND_WEBHOOK_SECRET=
# SendGrid's signed Event Webhook (`POST /v1/webhooks/mail/sendgrid`): the verification key the console shows (base64 SPKI). Public, not a secret. Unset: refused (403).
# SENDGRID_WEBHOOK_PUBLIC_KEY=
# Transient (soft) bounces within MAIL_SOFT_BOUNCE_WINDOW_HOURS before an address is suppressed.
# MAIL_SOFT_BOUNCE_THRESHOLD=3
# Soft bounces count when the previous one is at most this many hours old; older, the count starts over.
# MAIL_SOFT_BOUNCE_WINDOW_HOURS=24
# How long a soft-bounce suppression lasts; then the address is only watched again (a full mailbox empties).
# MAIL_SOFT_BOUNCE_SUPPRESSION_HOURS=72
# Bounce, complaint and delivery events (the trail behind the suppression list) older than this many days are deleted every night.
# MAIL_EVENTS_RETENTION_DAYS=90

# --- modules/documents ---
# Gotenberg (https://gotenberg.dev), the service that renders the PDF (Chromium in its own container). Unset, documents are off: asking for one is a 503 `documents_unavailable`; nothing else needs it.
# GOTENBERG_URL=
# One render's limit, in milliseconds; a render that takes longer is tried again.
# GOTENBERG_TIMEOUT_MS=30000
# Tries per document, the first included (exponential backoff from 1 s), before it fails.
# DOCUMENTS_RENDER_ATTEMPTS=3

# --- modules/images ---
# Pixels of one frame (width × height) an image may have to be processed; more is refused from its header, before a pixel is decoded (a decompression bomb: 50 KB of PNG can claim gigapixels). Memory is about 4 bytes per pixel while one image is converted.
# IMAGE_MAX_PIXELS=50000000
# One conversion's limit, in milliseconds; an image that takes longer is refused.
# IMAGE_TIMEOUT_MS=30000
# `on`: an original that carries metadata (EXIF, GPS, XMP, IPTC) is replaced by a copy without it (re-encoded: JPEG and WebP at quality 90, upright). `off`: originals stay byte for byte as uploaded; only the renditions are stripped.
# One of: on, off.
# IMAGE_STRIP_ORIGINALS=on

# --- modules/messaging ---
# SMS provider: `off`, `twilio`, or `memory` (tests: keeps what it would send). Off until configured: nothing leaves.
# One of: off, twilio, memory.
# SMS_PROVIDER=off
# TWILIO_ACCOUNT_SID=
# Secret: TWILIO_AUTH_TOKEN_FILE can name a file holding it instead.
# TWILIO_AUTH_TOKEN=
# The sending number (E.164) or a Messaging Service SID (`MG…`).
# TWILIO_FROM=
# The URL Twilio posts inbound messages to, when it is not APP_URL + the route (a proxy rewrites it): it is part of what Twilio signs.
# TWILIO_WEBHOOK_URL=
# Twilio's REST API (a stub on loopback in tests).
# TWILIO_API_URL=https://api.twilio.com
# Mobile push providers, comma-separated: `off` (default), `apns` (iOS), `fcm` (Android), `memory` (tests). `apns,fcm` serves both platforms; each device goes to the provider of its platform. Browsers' web push is the notifications module's.
# PUSH_PROVIDER=
# APNs (token-based auth): the .p8 key's id and contents (PEM; `\n` for newlines), the Apple team id, the app's bundle id.
# APNS_KEY_ID=
# Secret: APNS_PRIVATE_KEY_FILE can name a file holding it instead.
# APNS_PRIVATE_KEY=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNs' host: production by default; `https://api.sandbox.push.apple.com` for development builds (a stub on loopback in tests).
# APNS_API_URL=https://api.push.apple.com
# FCM (HTTP v1): the Firebase project id and the service account's `client_email` and `private_key` (PEM; `\n` for newlines).
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# Secret: FCM_PRIVATE_KEY_FILE can name a file holding it instead.
# FCM_PRIVATE_KEY=
# FCM_API_URL=https://fcm.googleapis.com
# Google's OAuth2 token endpoint (a stub on loopback in tests).
# FCM_TOKEN_URL=https://oauth2.googleapis.com/token
# Toll fraud: the destination country-calling-code prefixes SMS may go to (`+1,+44,+49`). Empty: none, so no SMS is sent until the deployment names the countries it serves.
# SMS_ALLOWED_PREFIXES=
# SMS a tenant may send per day, whoever the recipients.
# SMS_DAILY_LIMIT_PER_TENANT=200
# SMS a tenant may send per day to one allowed prefix (a premium-rate pump hits one prefix).
# SMS_DAILY_LIMIT_PER_PREFIX=100
# SMS one user may be sent per day (codes included).
# SMS_DAILY_LIMIT_PER_USER=10
# Codes one client IP may have texted per day in a tenant (the route also has its own throttle).
# SMS_DAILY_LIMIT_PER_IP=20
# A tenant's SMS spend cap per UTC month, in minor units of one currency; 0 is no cap. Sending stops at the cap; 80 % is logged as an error and shown by `sms_budget_used_ratio`.
# SMS_MONTHLY_BUDGET_MINOR=0
# The price of one SMS segment per prefix, minor units: `+1=79,+44=120`.
# SMS_PRICES=
# The price of one SMS segment to a prefix SMS_PRICES does not list.
# SMS_PRICE_DEFAULT_MINOR=0
# The longest SMS text, in characters; a longer one is cut.
# SMS_MAX_LENGTH=320
# The longest push payload, in bytes; a longer body is cut.
# PUSH_MAX_PAYLOAD_BYTES=3500
# A person's mobile devices that have not been seen for this many days are removed every night.
# MESSAGING_DEVICE_RETENTION_DAYS=270

# --- modules/mode ---
# Forces the deployment's mode: `normal`, `read-only` or `maintenance`. It wins over the operators' `platform.mode` setting, which then refuses a new value. For when the API cannot be reached to set it. Unset: the setting.
# One of: normal, read-only, maintenance.
# APP_MODE=

# --- modules/money ---
# Fetch the ECB's euro reference rates every working day (modules/money): off for an app without money, and in tests.
# One of: on, off.
# EXCHANGE_RATES_FETCH=on
# Where the ECB's eurofxref documents are (eurofxref-daily.xml, eurofxref-hist-90d.xml): a mirror, or a stub in tests.
# EXCHANGE_RATES_ECB_URL=https://www.ecb.europa.eu/stats/eurofxref

# --- modules/notifications ---
# Read notifications older than this many days are deleted every night.
# NOTIFICATIONS_RETENTION_DAYS=90
# Any notification older than this many days is deleted every night, read or not.
# NOTIFICATIONS_MAX_AGE_DAYS=365
# The hour (0-23, on each user's clock) the daily digest mail is sent.
# NOTIFICATIONS_DIGEST_HOUR=8
# The time zone (IANA) of users who chose none: digests and quiet hours follow its clock.
# NOTIFICATIONS_TIMEZONE=UTC
# A mailbox that also receives unsubscribe requests (RFC 8058 `List-Unsubscribe` `mailto:` form), besides the https link. Unset: the link only.
# MAIL_UNSUBSCRIBE_MAILTO=
# Turns web push on: who the push services may contact about it, `mailto:ops@example.com` or an https URL (VAPID subject). Unset: no web push, and no push channel.
# WEB_PUSH_SUBJECT=
# The VAPID public key (`npx web-push generate-vapid-keys`). Unset with the private key: made once and kept in the database.
# WEB_PUSH_PUBLIC_KEY=
# The VAPID private key; set both or neither.
# Secret: WEB_PUSH_PRIVATE_KEY_FILE can name a file holding it instead.
# WEB_PUSH_PRIVATE_KEY=
# A browser registered for push but not seen for this many days is forgotten every night.
# WEB_PUSH_DEVICE_RETENTION_DAYS=270

# --- modules/records ---
# Days a record stays in its recycle bin before it is purged (03:45 UTC): a declaration's `recycleBinDays` wins.
# SOFT_DELETE_RETENTION_DAYS=30

# --- modules/reports ---
# How long the download link a report's mail carries works, in hours (at most 7 days: the file is kept that long).
# REPORT_LINK_TTL_HOURS=24

# --- modules/revisions ---
# Revisions older than this many days are deleted every night (03:25 UTC); a record's latest always stays.
# REVISIONS_RETENTION_DAYS=365

# --- modules/sequences ---
# IANA time zone whose calendar decides a number's year, month and day (`YYYY`, `MM`…): a series restarts at that zone's new year.
# SEQUENCES_TIMEZONE=UTC

# --- modules/shares ---
# The most days a share link may work.
# SHARE_MAX_DAYS=30

# --- modules/storage ---
# Where files go: `local` (STORAGE_ROOT), `s3` (any S3-compatible store), `memory` (tests).
# One of: local, s3, memory.
# STORAGE_DRIVER=local
# The folder of the local disk; relative paths resolve against the working directory.
# STORAGE_ROOT=.data/storage
# Signs the app-served file URLs (local and memory disks): 32+ characters each, comma-separated, newest first. Unset, one is made once and kept in the database (core/secrets), so every instance signs with the same.
# Secret: STORAGE_SIGNING_KEYS_FILE can name a file holding it instead.
# STORAGE_SIGNING_KEYS=
# The bucket, required with STORAGE_DRIVER=s3.
# S3_BUCKET=
# `auto` for Cloudflare R2. Default: AWS_REGION, then us-east-1.
# S3_REGION=
# S3-compatible endpoints: https://<account>.r2.cloudflarestorage.com, http://minio:9000…
# S3_ENDPOINT=
# MinIO and most self-hosted stores.
# One of: on, off.
# S3_FORCE_PATH_STYLE=off

# --- modules/usage ---
# `off` stops counting API clients' requests: no usage routes, no roll-up, and daily client quotas are stored but not enforced.
# One of: on, off.
# USAGE=on
# Rolled-up usage rows older than this many days are deleted every night.
# USAGE_RETENTION_DAYS=400

# --- modules/webhooks ---
# on: webhook endpoints may be http://127.0.0.1 and http://localhost (that address only), for a receiver on this machine. Never in production.
# One of: on, off.
# WEBHOOKS_ALLOW_LOOPBACK=off
# The delivery worker, which signs and sends outgoing webhooks: off in tests (they drive it with runOnce()) and in a process that only dispatches.
# One of: on, off.
# WEBHOOKS_WORKER=on
# Outgoing deliveries that succeeded or failed for good this many days ago are deleted every night, with their attempt logs.
# WEBHOOKS_DELIVERY_RETENTION_DAYS=30
