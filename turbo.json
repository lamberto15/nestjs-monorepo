{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["GIT_SHA", "VITE_*"],
      "outputs": ["dist/**", ".bundle-analysis/**", "*.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "TEST_LOGS",
        "S3_TEST_*",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "size": {
      "dependsOn": ["build"],
      "inputs": ["dist/**", ".size-limit.json"]
    },
    "test:browser": {
      "dependsOn": ["api#build", "@nestjs-monorepo/web#build"],
      "cache": false
    }
  }
}
