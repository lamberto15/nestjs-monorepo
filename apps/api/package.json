{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "dev": "nest start --watch -b swc --type-check -p tsconfig.dev.json",
    "start": "nest start",
    "start:debug": "nest start --debug --watch -b swc --type-check -p tsconfig.dev.json",
    "start:prod": "node dist/main",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev:worker": "nest start --entryFile worker --watch -b swc --type-check -p tsconfig.dev.json",
    "start:worker": "node dist/worker",
    "start:migrate": "node dist/migrate",
    "db:seed:demo": "nest build && node dist/demo/seed-demo",
    "ops": "nest start --entryFile cli -b swc --type-check -p tsconfig.dev.json --",
    "openapi:dump": "nest build && node dist/openapi-dump",
    "feature:add": "schematics ./schematics/collection.json:feature --dry-run=false",
    "db:generate:fixtures": "drizzle-kit generate --config test/fixtures/drizzle.config.ts"
  },
