// knip: unused files, exports and dependencies (`pnpm knip`; CI runs it
// after the lint). Workspaces (apps/*, packages/*) come from
// pnpm-workspace.yaml; each is listed here only to add what knip can't find
// or to ignore, with the reason.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // An export used only inside its own file is not reported (it may be
  // exported for nothing, but removing it changes nothing for importers).
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      // Node scripts run by hand or by CI, not imported.
      "entry": ["tools/**/*.mjs"],
      "project": ["tools/**/*.mjs"],
      // tools/setup/vapid.mjs loads the API's web-push (apps/api/package.json)
      // from the API's folder, for its key generator: the root does not
      // depend on it.
      "ignoreDependencies": ["web-push"],
    },
    "apps/api": {
      // Started as `node dist/<name>` (package.json: start:worker,
      // start:migrate, ops, openapi:dump, db:seed:demo; the Docker image's
      // commands), by drizzle-kit (its config files are found by the plugin)
      // or by the schematics CLI.
      "entry": [
        "src/{main,worker,migrate,cli,openapi-dump}.ts",
        "src/demo/seed-demo.ts",
        "schematics/**/*.js",
        // An add-on's part of the feature generator: found by glob
        // (schematics/feature/addons.js), not imported.
        "src/modules/*/*.addon.js",
        // Started as a worker_threads thread by the module that owns it (a
        // URL, not an import).
        "src/**/*.worker.ts",
      ],
      // openssl: a spec signs a test certificate chain with it.
      "ignoreBinaries": ["openssl"],
      // Loaded with createRequire by the generator's test helper
      // (test/schematic.ts): CommonJS only.
      "ignoreDependencies": ["@angular-devkit/schematics"],
    },
    "apps/web": {
      // lighthouserc.json's `startServerCommand` runs it directly (not a
      // package.json script, which knip already reads as an entry).
      // public/push-sw.js: loaded into the generated service worker by
      // `workbox.importScripts` (vite.config.ts), a URL, not an import.
      // The record components only a generated feature's pages import (the
      // feature schematic's web-feature/templates.js; no feature ships):
      // entries, not ignored, so what they import counts as used. Single
      // exports only those pages use are tagged `@public` where they are.
      "entry": [
        "scripts/lighthouse-server.mjs",
        "public/push-sw.js",
        "src/components/records/custom-field-values.tsx",
        "src/features/merge/duplicates-warning.tsx",
      ],
      // Dice UI's data table: registry output the shadcn CLI writes, kept
      // whole so `shadcn add` updates apply (AGENTS.md: generate, never
      // hand-write). Parts of it are unused until a list page needs them.
      // Then what only a generated feature's pages import (the feature
      // schematic's web-feature/templates.js); no feature ships.
      "ignore": [
        "src/components/data-table/**",
        "src/lib/data-table-*.ts",
        "src/components/records/bulk-run-filter.tsx",
        "src/components/records/use-record-delete.tsx",
        "src/components/records/recycle-bin.tsx",
      ],
      // react-day-picker: the calendar of that same registry code.
      // tailwindcss: imported by the stylesheet (packages/ui), which
      // @tailwindcss/vite compiles; no JavaScript imports it.
      // @tanstack/router-generator: tools/feature-add.mjs loads it from here
      // (createRequire) to write the route tree after a feature is added.
      "ignoreDependencies": [
        "react-day-picker",
        "tailwindcss",
        "@tanstack/router-generator",
      ],
    },
    "apps/web-e2e": {
      "entry": ["test/**/*.ts", "scripts/*.mjs"],
    },
    "packages/api-client": {
      // Generated by openapi-typescript (`pnpm client:generate`).
      "ignore": ["src/schema.ts"],
    },
  },
}
